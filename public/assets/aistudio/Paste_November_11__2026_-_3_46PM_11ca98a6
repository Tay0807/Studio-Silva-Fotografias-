<script>
  (function () {
    // 1. Filtros Interativos do Portfólio
    const filterButtons = document.querySelectorAll('#portfolio-filters .filter-btn');
    const portfolioItems = document.querySelectorAll('#portfolio-grid .portfolio-item');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Estilização dos botões
        filterButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          b.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        btn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
        btn.classList.remove('bg-surface-container', 'text-on-surface-variant');

        const filterValue = btn.getAttribute('data-filter');

        portfolioItems.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filterValue === 'all' || category === filterValue) {
            item.style.display = 'block';
            setTimeout(() => {
              item.style.opacity = '1';
              item.style.transform = 'scale(1)';
            }, 50);
          } else {
            item.style.opacity = '0';
            item.style.transform = 'scale(0.96)';
            setTimeout(() => {
              item.style.display = 'none';
            }, 250);
          }
        });
      });
    });

    // 2. Lightbox Interativo
    const modal = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const btnClose = document.getElementById('lightbox-close');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');

    let visibleItems = [];
    let currentIndex = 0;

    function getVisibleItems() {
      return Array.from(portfolioItems).filter(item => item.style.display !== 'none');
    }

    function openLightbox(index) {
      visibleItems = getVisibleItems();
      if (!visibleItems.length) return;

      currentIndex = (index + visibleItems.length) % visibleItems.length;
      const targetItem = visibleItems[currentIndex];
      const img = targetItem.querySelector('img');

      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt || 'Foto do Studio Silva';
      lightboxTitle.textContent = targetItem.getAttribute('data-title') || '';
      lightboxCaption.textContent = targetItem.getAttribute('data-caption') || '';

      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal.classList.add('opacity-0');
      modal.classList.remove('opacity-100');
      modal.setAttribute('aria-hidden', 'true');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }

    function nextImage() {
      openLightbox(currentIndex + 1);
    }

    function prevImage() {
      openLightbox(currentIndex - 1);
    }

    portfolioItems.forEach((item) => {
      item.addEventListener('click', () => {
        visibleItems = getVisibleItems();
        const clickedIndex = visibleItems.indexOf(item);
        if (clickedIndex !== -1) {
          openLightbox(clickedIndex);
        }
      });
    });

    btnClose.addEventListener('click', closeLightbox);
    btnNext.addEventListener('click', (e) => { e.stopPropagation(); nextImage(); });
    btnPrev.addEventListener('click', (e) => { e.stopPropagation(); prevImage(); });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (modal.getAttribute('aria-hidden') === 'false') {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') nextImage();
        if (e.key === 'ArrowLeft') prevImage();
      }
    });

    // 3. Formatação e Redirecionamento Amigável WhatsApp
    const form = document.getElementById('contact-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const name = document.getElementById('form-name').value.trim();
        const phone = document.getElementById('form-phone').value.trim();
        const type = document.getElementById('form-type').value;
        const date = document.getElementById('form-date').value.trim();
        const city = document.getElementById('form-city').value.trim();
        const message = document.getElementById('form-message').value.trim();

        let text = `Olá, Studio Silva! Gostaria de consultar um orçamento:%0A%0A`;
        text += `*Nome:* ${encodeURIComponent(name)}%0A`;
        text += `*WhatsApp:* ${encodeURIComponent(phone)}%0A`;
        text += `*Tipo de Evento:* ${encodeURIComponent(type)}%0A`;
        if (date) text += `*Data Prevista:* ${encodeURIComponent(date)}%0A`;
        if (city) text += `*Cidade:* ${encodeURIComponent(city)}%0A`;
        if (message) text += `*Detalhes:* ${encodeURIComponent(message)}%0A`;

        const whatsappUrl = `https://wa.me/5518991487884?text=${text}`;
        window.open(whatsappUrl, '_blank');
      });
    }

    // 4. Suavização de scroll para âncoras internas
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        const targetId = this.getAttribute('href');
        if (targetId && targetId !== '#') {
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

  })();
</script></main><aside class="fixed bottom-6 right-6 z-50 group flex items-center justify-end"><div class="mr-3 px-3 py-1.5 rounded-lg bg-inverse-surface text-inverse-on-surface font-label-md text-label-md opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none shadow-lg whitespace-nowrap">Fale no WhatsApp</div><a aria-label="Fale no WhatsApp" class="w-14 h-14 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-[0_8px_24px_rgba(123,83,52,0.28)] hover:bg-primary-container transition-transform hover:scale-105 active:scale-95" href="https://wa.me/5518991487884?text=Ol%C3%A1!%20Conheci%20o%20Studio%20Silva%20pelo%20site%20e%20gostaria%20de%20solicitar%20um%20or%C3%A7amento%20para%20um%20evento." rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-[28px]">forum</span></a></aside><footer class="w-full bg-surface-container-low text-on-surface"><div class="max-w-7xl mx-auto px-6 lg:px-12 py-16"><div class="grid grid-cols-1 md:grid-cols-12 gap-12"><div class="md:col-span-5 flex flex-col gap-4"><a class="inline-block" href="#inicio"><img alt="Logo Studio Silva Fotografias" class="h-12 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/ALJJyrAgXM-YZycf2bjnPTbpPYRmdNToDjaTLV4PWAuurgmWRrn0xpvC2VDcbOQKtbJxz0isJo7-14YtzpvpvXzEmpSQQr1SayRT2WTpDWnguzoRK0dGi4225MDdkgQ3ZgqNJj93WsvXhsCByTYI-8tGUg5Q2j_Wm5zrKQD5tDkEfFpbZjwb3yO2uDAS8tyEj81FFGZH_5uP4Zez0liPzCsh7S4HnvTAAd4D0fgiQABn5mIBPw"></a><p class="font-headline-sm text-headline-sm text-primary italic mt-2">Studio Silva Fotografias</p><p class="font-body-md text-body-md text-on-surface-variant max-w-md">Registrando histórias com sensibilidade, carinho e tradição em Penápolis e região. Ensaios de família, casamentos, gestantes e momentos que atravessam gerações.</p></div><div class="md:col-span-3 flex flex-col gap-4"><h4 class="font-label-lg text-label-lg uppercase tracking-wider text-secondary">Navegação</h4><nav class="flex flex-col gap-2.5">