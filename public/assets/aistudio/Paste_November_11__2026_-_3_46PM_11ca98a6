    const cancelUploadBtn = document.getElementById('cancel-upload-btn');
    const confirmUploadBtn = document.getElementById('confirm-upload-btn');

    // Delete Modal Elements
    const deleteModal = document.getElementById('delete-confirm-modal');
    const deleteTargetTitle = document.getElementById('delete-target-title');
    const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
    const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
    let itemPendingDeletion = null;

    // Toast element
    const toast = document.getElementById('action-toast');
    const toastMsg = document.getElementById('toast-message');
    const toastIcon = document.getElementById('toast-icon');

    function showToast(message, icon = 'check_circle') {
      toastMsg.textContent = message;
      toastIcon.textContent = icon;
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3500);
    }

    // --- State ---
    let currentCategory = 'all';
    let currentSearch = '';
    let currentStatus = 'all';

    // --- Filter & Search Logic ---
    function applyFilters() {
      let visibleCount = 0;

      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const status = card.getAttribute('data-status');
        const isFeatured = card.getAttribute('data-featured') === 'true';
        const title = card.querySelector('h3').textContent.toLowerCase();
        const locationText = card.querySelector('p').textContent.toLowerCase();

        // Check Category
        const matchesCategory = (currentCategory === 'all') || (cat === currentCategory);

        // Check Status
        let matchesStatus = true;
        if (currentStatus === 'published') matchesStatus = (status === 'published');
        if (currentStatus === 'draft') matchesStatus = (status === 'draft');
        if (currentStatus === 'featured') matchesStatus = isFeatured;

        // Check Search
        const query = currentSearch.toLowerCase().trim();
        const matchesSearch = !query || title.includes(query) || locationText.includes(query) || cat.includes(query);

        if (matchesCategory && matchesStatus && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Handle Empty State
      if (visibleCount === 0) {
        cardsGrid.classList.add('hidden');
        emptyState.classList.remove('hidden');
        emptyState.classList.add('flex');
      } else {
        cardsGrid.classList.remove('hidden');
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');
      }

      updateBulkBanner();
    }

    // Category Tabs Click
    categoryTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach(t => {
          t.classList.remove('bg-primary', 'text-on-primary', 'font-semibold', 'shadow-sm');
          t.classList.add('bg-surface-container-low', 'text-secondary');
          const badge = t.querySelector('span:last-child');
          if (badge) {
            badge.className = 'px-1.5 py-0.5 rounded-full text-[10px] bg-surface-variant text-on-surface-variant font-bold';
          }
        });

        tab.classList.remove('bg-surface-container-low', 'text-secondary');
        tab.classList.add('bg-primary', 'text-on-primary', 'font-semibold', 'shadow-sm');
        const badge = tab.querySelector('span:last-child');
        if (badge) {
          badge.className = 'px-1.5 py-0.5 rounded-full text-[10px] bg-on-primary/20 text-on-primary font-bold';
        }

        currentCategory = tab.getAttribute('data-cat');
        applyFilters();
      });
    });

    // Search input
    searchInput.addEventListener('input', (e) => {
      currentSearch = e.target.value;
      if (currentSearch.length > 0) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }
      applyFilters();
    });

    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      currentSearch = '';
      clearSearchBtn.classList.add('hidden');
      applyFilters();
    });

    // Status filter
    statusFilter.addEventListener('change', (e) => {
      currentStatus = e.target.value;
      applyFilters();
    });

    // Reset Filters button
    resetFiltersBtn.addEventListener('click', () => {
      currentSearch = '';
      searchInput.value = '';
      clearSearchBtn.classList.add('hidden');
      statusFilter.value = 'all';
      currentStatus = 'all';

      // reset tabs to all
      const allTab = document.querySelector('.cat-pill[data-cat="all"]');
      if (allTab) allTab.click();
    });

    // --- Bulk Selection ---
    function updateBulkBanner() {
      const visibleCheckboxes = Array.from(document.querySelectorAll('.photo-card:not(.hidden) .card-select-checkbox'));
      const checkedBoxes = visibleCheckboxes.filter(cb => cb.checked);
      
      if (checkedBoxes.length > 0) {
        bulkBanner.classList.remove('hidden');
        bulkBanner.classList.add('flex');
        selectedCountSpan.textContent = checkedBoxes.length;
      } else {
        bulkBanner.classList.add('hidden');
        bulkBanner.classList.remove('flex');
      }

      selectAllVisible.checked = visibleCheckboxes.length > 0 && visibleCheckboxes.every(cb => cb.checked);
    }

    cardCheckboxes.forEach(cb => {
      cb.addEventListener('change', updateBulkBanner);
    });

    selectAllVisible.addEventListener('change', (e) => {
      const visibleCheckboxes = document.querySelectorAll('.photo-card:not(.hidden) .card-select-checkbox');
      visibleCheckboxes.forEach(cb => {
        cb.checked = e.target.checked;
      });
      updateBulkBanner();
    });

    // --- Card Actions: Star, Visibility, Edit, Delete ---
    document.querySelectorAll('.action-btn-star').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const card = btn.closest('.photo-card');
        const icon = btn.querySelector('.material-symbols-outlined');
        const isFeatured = card.getAttribute('data-featured') === 'true';

        if (isFeatured) {
          card.setAttribute('data-featured', 'false');
          btn.classList.remove('text-primary');
          btn.classList.add('text-outline');
          icon.style.fontVariationSettings = "'FILL' 0";
          
          // Remove or hide badge on image if present
          const badge = card.querySelector('.aspect-\\[4\\/3\\] .bg-primary');
          if (badge) badge.remove();
          showToast('Fotografia removida dos destaques da vitrine.');
        } else {
          card.setAttribute('data-featured', 'true');
          btn.classList.remove('text-outline');
          btn.classList.add('text-primary');
          icon.style.fontVariationSettings = "'FILL' 1";

          // Add badge on top left
          const badgeContainer = card.querySelector('.aspect-\\[4\\/3\\] .flex.items-center.justify-between');
          if (badgeContainer && !card.querySelector('.aspect-\\[4\\/3\\] .bg-primary')) {
            const newBadge = document.createElement('span');
            newBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-primary text-on-primary font-label-sm text-label-sm font-semibold shadow-md pointer-events-auto';
            newBadge.innerHTML = `<span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">star</span><span>Destaque Vitrine</span>`;
            badgeContainer.prepend(newBadge);
          }
          showToast('Fotografia promovida a Destaque na vitrine principal!');
        }
      });
    });

    document.querySelectorAll('.action-btn-toggle-vis').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.photo-card');
        const status = card.getAttribute('data-status');
        const icon = btn.querySelector('.material-symbols-outlined');
        const statusBadge = card.querySelector('.aspect-\\[4\\/3\\] span:last-child');

        if (status === 'published') {
          card.setAttribute('data-status', 'draft');
          icon.textContent = 'visibility_off';
          btn.setAttribute('title', 'Publicar no site');
          if (statusBadge) {
            statusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-variant/90 backdrop-blur-sm text-on-surface-variant font-label-sm text-label-sm font-semibold shadow-sm pointer-events-auto';
            statusBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-outline"></span><span>Rascunho</span>';
          }
          showToast('Visibilidade alterada para Rascunho (Privado).');
        } else {
          card.setAttribute('data-status', 'published');
          icon.textContent = 'visibility';
          btn.setAttribute('title', 'Ocultar do site');
          if (statusBadge) {
            statusBadge.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container-lowest/90 backdrop-blur-sm text-on-surface font-label-sm text-label-sm font-semibold shadow-sm pointer-events-auto';
            statusBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-primary-container"></span><span>Publicado</span>';
          }
          showToast('Fotografia publicada com sucesso no portfólio!');
        }
      });
    });

    // Delete Trigger
    document.querySelectorAll('.action-btn-delete').forEach(btn => {
      btn.addEventListener('click', () => {
        itemPendingDeletion = btn.closest('.photo-card');
        const title = btn.getAttribute('data-title') || 'esta fotografia';
        deleteTargetTitle.textContent = `"${title}"`;

        deleteModal.classList.remove('hidden');
        setTimeout(() => {
          deleteModal.classList.remove('opacity-0');
          deleteModal.querySelector('div').classList.remove('scale-95');
        }, 10);
      });
    });

    function closeDeleteModal() {
      deleteModal.classList.add('opacity-0');
      deleteModal.querySelector('div').classList.add('scale-95');
      setTimeout(() => {
        deleteModal.classList.add('hidden');
        itemPendingDeletion = null;
      }, 200);
    }

    cancelDeleteBtn.addEventListener('click', closeDeleteModal);

    confirmDeleteBtn.addEventListener('click', () => {
      if (itemPendingDeletion) {
        itemPendingDeletion.remove();
        let currentTotal = parseInt(counterTotal.textContent, 10);
        if (!isNaN(currentTotal) && currentTotal > 0) {
          counterTotal.textContent = currentTotal - 1;
        }
        showToast('Fotografia excluída do acervo permanentemente.', 'delete');
        updateBulkBanner();
      }
      closeDeleteModal();
    });

    // --- Upload Modal Logic ---
    function openUpload() {
      uploadModal.classList.remove('hidden');
      setTimeout(() => {
        uploadModal.classList.remove('opacity-0');
        uploadModal.querySelector('div').classList.remove('scale-95');
      }, 10);
    }

    function closeUpload() {
      uploadModal.classList.add('opacity-0');
      uploadModal.querySelector('div').classList.add('scale-95');
      setTimeout(() => {
        uploadModal.classList.add('hidden');
      }, 300);
    }

    openUploadBtn.addEventListener('click', openUpload);
    closeUploadBtn.addEventListener('click', closeUpload);
    cancelUploadBtn.addEventListener('click', closeUpload);

    confirmUploadBtn.addEventListener('click', () => {
      showToast('3 novas fotografias adicionadas com sucesso à galeria!');
      let currentTotal = parseInt(counterTotal.textContent, 10);
      if (!isNaN(currentTotal)) {
        counterTotal.textContent = currentTotal + 3;
      }
      closeUpload();
    });

    // Clear Upload Queue
    const clearQueueBtn = document.getElementById('clear-upload-queue');
    if (clearQueueBtn) {
      clearQueueBtn.addEventListener('click', () => {
        showToast('Fila de upload esvaziada.', 'info');
      });
    }

    // ESC key closes modals
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!uploadModal.classList.contains('hidden')) closeUpload();
        if (!deleteModal.classList.contains('hidden')) closeDeleteModal();
      }
    });

  })();
</script></main></div></body></html>

